{
  "info": {
    "_postman_id": "8130cba4-890c-44e0-8714-458688653f6a",
    "name": "Users API Collection (PadiBase)",
    "description": "REST Client API Collection for 'users' generated by PadiBase (compatible with Postman, Insomnia, Thunder Client, Bruno, and VS Code REST Client).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8090"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "record_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth With Password (Users)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "    if (pm.response.code === 200) {",
              "        const res = pm.response.json();",
              "        const token = res.data?.token || res.token;",
              "        const item = res.data?.record || res.record || res.data?.item || res.item;",
              "        if (token) pm.collectionVariables.set('auth_token', token);",
              "        const id = item?.id;",
              "        if (id) {",
              "            pm.collectionVariables.set('user_id', id);",
              "            pm.collectionVariables.set('user_id', id);",
              "        }",
              "    }",
              "} catch (e) {",
              "    console.warn('Auth script bypassed:', e);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identity\": \"user@example.com\",\n  \"password\": \"Password123!@#\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/collections/users/auth-with-password"
        },
        "description": "Authenticate an auth record in collection 'users' with identity (email or username) and password. Automatically stores auth_token and ID variables."
      }
    },
    {
      "name": "List Users (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/collections/users/records?page=1&perPage=30&sort=-created"
        },
        "description": "Fetch paginated records for 'users' with sorting, filtering, and standard Padi Rust envelope."
      }
    },
    {
      "name": "List All Users (Padi Rust records/all)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/collections/users/records/all?sort_by=id&order=desc"
        },
        "description": "Retrieve all records for 'users' without pagination (Padi Rust standard)."
      }
    },
    {
      "name": "List All Users (Direct /api/users/all)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/all?sort_by=id&order=desc"
        },
        "description": "Clean direct route matching Padi Rust standard (GET /api/users/all)."
      }
    },
    {
      "name": "Get Users By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/collections/users/records/{{user_id}}"
        },
        "description": "Get a single record from 'users' by its 15-character unique ID."
      }
    },
    {
      "name": "Create Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "    if (pm.response.code === 201 || pm.response.code === 200) {",
              "        const res = pm.response.json();",
              "        const item = res.data?.item || res.item || res.data || res;",
              "        const id = item?.id || res.id;",
              "        if (id) {",
              "            pm.collectionVariables.set('user_id', id);",
              "            pm.collectionVariables.set('record_id', id);",
              "        }",
              "    }",
              "} catch (e) {",
              "    console.warn('Script bypassed:', e);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"user123\",\n  \"email\": \"sample@example.com\",\n  \"password\": \"Password123!@#\",\n  \"passwordConfirm\": \"Password123!@#\",\n  \"name\": \"Sample Name\",\n  \"avatar\": \"sample_attachment.jpg\",\n  \"emailVisibility\": 1,\n  \"verified\": 1,\n  \"passwordHash\": \"Secret123!@#\",\n  \"tokenKey\": \"Sample TokenKey\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/collections/users/records"
        },
        "description": "Insert a new record into 'users'. Automatically saves the created ID into variable '{user_id}'."
      }
    },
    {
      "name": "Update Users",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"user123_updated\",\n  \"name\": \"Sample Name\",\n  \"avatar\": \"sample_attachment.jpg\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/collections/users/records/{{user_id}}"
        },
        "description": "Partially update an existing record in 'users'."
      }
    },
    {
      "name": "Delete Users",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/collections/users/records/{{user_id}}"
        },
        "description": "Delete an existing record in 'users' by ID."
      }
    },
    {
      "name": "Export Records JSON (Users)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/collections/users/export"
        },
        "description": "Export all records from collection 'users' as raw JSON."
      }
    },
    {
      "name": "Import Records JSON (Users)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n  \"username\": \"user123\",\n  \"email\": \"sample@example.com\",\n  \"password\": \"Password123!@#\",\n  \"passwordConfirm\": \"Password123!@#\",\n  \"name\": \"Sample Name\",\n  \"avatar\": \"sample_attachment.jpg\",\n  \"emailVisibility\": 1,\n  \"verified\": 1,\n  \"passwordHash\": \"Secret123!@#\",\n  \"tokenKey\": \"Sample TokenKey\"\n}\n]"
        },
        "url": {
          "raw": "{{base_url}}/api/collections/users/import"
        },
        "description": "Bulk import an array of record objects into 'users'."
      }
    }
  ]
}