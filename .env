# ============================================================================
# PadiBase - Environment & Database Configuration (.env)
# Compatible with Padi Rust API Framework (padi_core)
# ============================================================================

APP_NAME="PadiBase Studio"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8085

# ============================================================================
# DATABASE SELECTION
# Default: SQLite (Aktif).
# Untuk ganti database, beri tanda '#' pada konfigurasi SQLite di bawah,
# lalu hilangkan tanda '#' (uncomment) pada blok database yang ingin digunakan.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SQLITE (Default - Aktif)
# ----------------------------------------------------------------------------
# DB_DRIVER=sqlite
# DB_DATABASE=padi_data/data.db
# DB_MAX_CONNECTIONS=20

# ----------------------------------------------------------------------------
# 2. MYSQL (Uncomment jika ingin menggunakan MySQL)
# ----------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_moca
DB_USERNAME=root
DB_PASSWORD=wibie
DB_MAX_CONNECTIONS=20

# ----------------------------------------------------------------------------
# 3. MARIADB (Uncomment jika ingin menggunakan MariaDB)
# ----------------------------------------------------------------------------
# DB_DRIVER=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=db_padi
# DB_USERNAME=root
# DB_PASSWORD=
# DB_MAX_CONNECTIONS=20

# ----------------------------------------------------------------------------
# 4. POSTGRESQL (Uncomment jika ingin menggunakan PostgreSQL)
# ----------------------------------------------------------------------------
# DB_DRIVER=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=db_padi
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_MAX_CONNECTIONS=20

# ----------------------------------------------------------------------------
# 5. ATAU MENGGUNAKAN SATU BARIS DATABASE_URL LENGKAP (Opsional)
# ----------------------------------------------------------------------------
# DATABASE_URL=sqlite://padi_data/data.db
# DATABASE_URL=mysql://root:@127.0.0.1:3306/db_padi
# DATABASE_URL=mariadb://root:@127.0.0.1:3306/db_padi
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/db_padi

# ============================================================================
# API Response Format (Padi Rust Standard)
# Options: full (default: message, message_code, success, item, meta, debug)
#          simple (message, success, item, meta)
#          raw (data tanpa envelope)
# ============================================================================
RESPONSE_FORMAT=full

# ============================================================================
# Relationships & Eager Loading (Padi Rust Standard)
# Auto-loads related models (e.g. author_id -> author: { id, name })
# Global option:
#   true  = Eager load relations automatically for ALL tables globally.
#   false = Follow per-table setting configured in Dashboard (table default: false).
# ============================================================================
AUTO_LOAD_RELATIONS=false

# ============================================================================
# Security & CORS
# ============================================================================
JWT_SECRET=4qilcano2d7xez6fu1htyb9jpvw3rks8g50m
CORS_ALLOWED_ORIGINS=*

# ============================================================================
# SMTP & Outgoing Email Configuration (PadiBase Standard)
# ============================================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
SMTP_FROM_NAME="PadiBase Studio"
SMTP_FROM_ADDRESS=noreply@example.com
